<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  This is a SAMPLE, not a working config, and the app deliberately ignores it.

  To connect the app to Firebase:
    1. Firebase console → Add app → iOS, bundle id com.meridian.travelplanner
       (or change bundleIdentifier in Package.swift to match your own).
    2. Download the real GoogleService-Info.plist.
    3. Drop it in this folder, named exactly GoogleService-Info.plist.

  The real file is git-ignored — it identifies your Firebase project and
  should not be committed to a shared repository.
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>REPLACE_WITH_YOUR_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>REPLACE_WITH_YOUR_SENDER_ID</string>
	<key>PROJECT_ID</key>
	<string>replace-with-your-project-id</string>
	<key>STORAGE_BUCKET</key>
	<string>replace-with-your-project-id.appspot.com</string>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
	<key>BUNDLE_ID</key>
	<string>com.meridian.travelplanner</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<false/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>PLIST_VERSION</key>
	<string>1</string>
</dict>
</plist>
